# Copy to .env for local use. Never commit real values.
# In GitHub, set these as repository secrets instead.

# Keyed sources (used from later steps; step 1 only uses keyless sources)
FRED_API_KEY=
NVD_API_KEY=
GROQ_API_KEY=
NEWSDATA_API_KEY=
EIA_API_KEY=
COMTRADE_API_KEY=
OTX_API_KEY=
TIINGO_API_KEY=
CURRENTS_API_KEY=

# Neon Postgres connection strings (see docs/database-roles.md)
# Owner role: migrations and infra/scripts/create_login_roles.py only
DATABASE_URL_MIGRATE=
# Login role in rp_feeds: public feeds schema (jobs/, GitHub Actions)
DATABASE_URL_FEEDS=
# Login role in rp_app: business schema under row-level security (api/ and worker/), Neon pooled host.
# With docker compose: postgresql://riskpredict_app:<password>@postgres:5432/riskpredict
DATABASE_URL_APP=

# api / worker (see README "Environment variables per service"; values here are placeholders only)
# Generate secrets with:  python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# api: signs access tokens (base64, >= 32 bytes)
JWT_SIGNING_KEY=
# api + worker: k1:<base64 32 bytes>[,k0:<older key>]; the first entry encrypts Google refresh tokens, all decrypt
TOKEN_ENCRYPTION_KEYS=
# api + worker: shared secret for POST /internal/events and GET /internal/work
INTERNAL_TOKEN=
# api: the dashboard's origin (CORS, OAuth redirects back), e.g. https://riskpredict.pages.dev
WEB_ORIGIN=
# api + worker: the API's public HTTPS base; Google OAuth callback and Drive webhook address
PUBLIC_API_URL=
# worker: the API on the private network, e.g. http://api:8000
API_INTERNAL_URL=
# api + worker: Google Cloud OAuth client (Drive, Sheets and Picker APIs enabled)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# api (public): browser key for the Picker, HTTP-referrer restricted; and the project number (Picker app_id)
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=
# api + worker: Composio Hobby; without it only Google Sheets is offered
COMPOSIO_API_KEY=
# api: the webhook subscription's signing secret
COMPOSIO_WEBHOOK_SECRET=
# api + worker: <app>:<auth config id> per tool, e.g. airtable:ac_xxxxxxxx
COMPOSIO_AUTH_CONFIGS=
# worker (optional): <app>:<trigger slug> to subscribe to on connect; the 15-minute re-read works without it
COMPOSIO_TRIGGER_SLUGS=
# api + worker: Groq model ids (GROQ_API_KEY is above); Groq renames models, so they are configurable
GROQ_MAPPING_MODEL=
GROQ_ADVICE_MODEL=
# Optional tuning (defaults shown in README)
# EXPECTED_SCHEMA_VERSION=007_biz_lookups
# DB_MAX_CONNECTIONS=5
# WORKER_DB_INTERVAL_SECONDS=1800
# SOURCE_RECHECK_SECONDS=900
# ADVICE_PER_RUN=20
# FORWARDED_ALLOW_IPS=127.0.0.1
# INTERNAL_LOOPBACK_ONLY=false   # true in the Render image (API and worker in one container)

# web (public, baked into the build)
VITE_API_BASE_URL=
